{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinora Staging",
  "identifier": "io.github.millsydotdev.kinora.staging",
  "build": {
    "beforeBuildCommand": "npm run build:staging"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kinora [Staging]"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/millsydotdev/KinoraTV/releases/download/staging-latest/latest.json"
      ]
    }
  }
}
