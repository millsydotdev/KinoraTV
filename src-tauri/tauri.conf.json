{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinora",
  "version": "../package.json",
  "identifier": "io.github.millsydotdev.kinora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kinora",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost kstream://localhost",
        "media-src": "blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Live TV, movies and series",
    "longDescription": "Kinora is a desktop media platform for playing personal IPTV sources, M3U playlists, Xtream codes providers, and XMLTV guides with a privacy-focused local architecture.",
    "copyright": "Copyright 2026 Kinora Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl3"
        ],
        "section": "video"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator3",
          "librsvg2",
          "openssl-libs"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": null,
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": null,
        "windowPosition": { "x": 400, "y": 400 },
        "windowSize": { "width": 640, "height": 480 }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/millsydotdev/KinoraTV/releases/latest/download/latest.json"
      ]
    }
  }
}
