{
  "name": "kinora",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:staging": "tsc -b && vite build --mode staging",
    "tauri:dev:staging": "tauri dev --config src-tauri/tauri.staging.conf.json",
    "tauri:build:staging": "tauri build --config src-tauri/tauri.staging.conf.json",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:gate": "bash scripts/quality-gate.sh",
    "version:check": "node scripts/validate-version.cjs",
    "version:sync": "node scripts/sync-version.cjs",
    "setup": "bash scripts/onboarding.sh",
    "sbom": "node scripts/generate-sbom.cjs",
    "docker:up": "docker compose up -d fixtures",
    "docker:down": "docker compose down",
    "docker:web": "docker compose up web",
    "docker:test": "docker compose run --rm test",
    "ci": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "cmdk": "^1.1.1",
    "dashjs": "5.2.1",
    "hls.js": "1.7.3",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
