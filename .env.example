# Kinora Environment Variables Template (v0.6.0)
# Copy this file to .env and configure local overrides
#
# Security Note: Never commit .env to source control.

# The Movie Database (TMDB) API Key (optional metadata enrichment)
VITE_TMDB_API_KEY=
TMDB_API_KEY=

# Docker Compose Service Ports (defaults: 5199 for web, 18765 for mock fixtures)
WEB_PORT=5199
FIXTURE_PORT=18765

# Local Application Environment (development, staging, production)
APP_ENV=development
